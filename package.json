{
  "name": "voiceform",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "predev": "node scripts/sync-web-env.mjs",
    "dev": "turbo run dev",
    "prebuild": "node scripts/sync-web-env.mjs",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "api:dev": "uv run --directory apps/api uvicorn voiceform.main:app --reload --port 8000",
    "api:worker": "uv run --directory apps/api arq voiceform.workers.settings.WorkerSettings",
    "api:migrate": "uv run --directory apps/api alembic upgrade head",
    "api:check": "uv run --directory apps/api python scripts/check_env.py",
    "api:revision": "uv run --directory apps/api alembic revision --autogenerate -m",
    "api:lint": "uv run --directory apps/api ruff check .",
    "api:format": "uv run --directory apps/api ruff format .",
    "api:test": "uv run --directory apps/api pytest",
    "api:typecheck": "uv run --directory apps/api mypy src",
    "client:generate": "pnpm --filter @voiceform/api-client generate",
    "services:up": "docker compose up -d",
    "services:down": "docker compose down",
    "env:sync": "node scripts/sync-web-env.mjs"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-switch": "^1.1.1"
  }
}
