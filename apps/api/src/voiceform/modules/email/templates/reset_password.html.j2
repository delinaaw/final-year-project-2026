{% extends "base.html.j2" %}
{% block content %}
<h1 style="margin:0 0 12px;font-size:24px;color:#01033e;">Reset your password</h1>
<p style="margin:0 0 24px;color:#5d5d83;">Click the button below to choose a new password.</p>
<a href="{{ reset_url }}" style="display:inline-block;background:#807dfe;color:#ffffff;text-decoration:none;padding:14px 28px;border-radius:10px;font-weight:600;">Reset password</a>
<p style="margin:24px 0 0;color:#5d5d83;">This link expires in {{ ttl_minutes }} minutes. If you did not request it, you can ignore this email.</p>
{% endblock %}
