{% extends "base.html.j2" %}
{% block content %}
<h1 style="margin:0 0 12px;font-size:24px;color:#01033e;">{{ inviter_name }} invited you to answer a form</h1>
<p style="margin:0 0 8px;font-weight:600;color:#01033e;">{{ form_title }}</p>
<p style="margin:0 0 24px;color:#5d5d83;">You can speak your answers instead of typing them.</p>
<a href="{{ form_url }}" style="display:inline-block;background:#807dfe;color:#ffffff;text-decoration:none;padding:14px 28px;border-radius:10px;font-weight:600;">Open the form</a>
{% endblock %}
