<!doctype html>
<html>
  <body style="margin:0;padding:0;background:#fdfdfd;font-family:'Helvetica Neue',Arial,sans-serif;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="padding:32px 16px;">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:520px;background:#ffffff;border:1px solid #e3e3e3;border-radius:16px;padding:32px;">
            <tr>
              <td style="padding-bottom:24px;">
                <span style="font-size:18px;font-weight:700;color:#01033e;">VoiceForm</span>
              </td>
            </tr>
            <tr>
              <td style="font-size:16px;line-height:24px;color:#01033e;">
                {% block content %}{% endblock %}
              </td>
            </tr>
            <tr>
              <td style="padding-top:32px;border-top:1px solid #e3e3e3;font-size:12px;line-height:18px;color:#9999b1;">
                You received this email because of activity on your VoiceForm account.
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
